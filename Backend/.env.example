# Postgres
DATABASE_URL=postgres://shiitake:CAMBIAR@postgres:5432/shiitake

# Firma las sesiones (JWT) de login — 100% local, sin ningún proveedor externo. Generar una vez con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO

# Firma OTA (Ed25519). Generar con: node scripts/generar-clave-ota.js
OTA_SIGNING_PRIVATE_KEY_PATH=/run/secrets/ota-signing-key.pem

# Directorio donde se guardan los binarios .bin subidos (montado como volumen)
FIRMWARE_DIR=/data/firmware

# Puerto HTTP/WS del backend
PORT=3001

# Cuenta admin garantizada al arrancar (se crea sola si no existe, sin pisar una que ya tenga
# password_hash puesto). Si no defines ADMIN_BOOTSTRAP_PASSWORD, se genera una al azar y se
# imprime una sola vez en los logs del backend al arrancar — cámbiala después del primer login.
ADMIN_BOOTSTRAP_EMAIL=german8264@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=

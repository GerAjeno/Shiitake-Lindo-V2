{
  "name": "shiitake-lindo-backend",
  "version": "2.0.0",
  "description": "API REST + WebSocket + Postgres para Shiitake-Lindo V2",
  "main": "dist/index.js",
  "scripts": {
    "predev": "rm -rf src/shared && ln -s ../../Shared src/shared",
    "dev": "node --require ts-node/register/transpile-only src/index.ts",
    "prebuild": "rm -rf src/shared && ln -s ../../Shared src/shared",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node --require ts-node/register/transpile-only src/db/migrate.ts",
    "migrate:down": "node --require ts-node/register/transpile-only src/db/migrate.ts down",
    "ota:generar-clave": "node scripts/generar-clave-ota.js",
    "dispositivo:provisionar": "node scripts/provisionar-dispositivo.js",
    "migrar:firebase": "node scripts/migrar-datos-firebase.js",
    "pretest": "rm -rf src/shared && ln -s ../../Shared src/shared",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.8",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "firebase-admin": "^12.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11"
  },
  "keywords": [],
  "type": "commonjs"
}

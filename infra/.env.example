# Dominio público servido por este stack (Cloudflare Tunnel apunta acá).
# Durante la marcha blanca: prueba.ger-cloud.cc — al promover a producción: shiitake.ger-cloud.cc
PUBLIC_DOMAIN=prueba.ger-cloud.cc
PUBLIC_BASE_URL=https://prueba.ger-cloud.cc

POSTGRES_USER=shiitake
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_FUERTE
POSTGRES_DB=shiitake
DATABASE_URL=postgres://shiitake:CAMBIAR_POR_UNA_CLAVE_FUERTE@postgres:5432/shiitake

# Login 100% local (sin Firebase ni ningún proveedor externo) — firma las sesiones (JWT).
# Generar una vez con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO

OTA_SIGNING_PRIVATE_KEY_PATH=/run/secrets/ota-signing-key.pem

# Cuenta admin garantizada al arrancar el backend (se crea sola la primera vez, sin pisar una
# que ya tenga contraseña puesta). Si dejas la contraseña vacía, se genera una al azar y se
# imprime una sola vez en los logs del backend — cámbiala después del primer login.
ADMIN_BOOTSTRAP_EMAIL=german8264@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=

# Túnel de Cloudflare (Zero Trust -> Access -> Tunnels -> crear token)
CLOUDFLARE_TUNNEL_TOKEN=

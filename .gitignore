**/*.key
infra/secrets/

# Postgres data volume si se monta local
infra/postgres/data/

# Build artifacts
*.tsbuildinfo

# Backend/src/shared es un symlink a ../../Shared (ver Backend/package.json predev/prebuild) para
# que tsc no falle con TS6059 (rootDir) sin duplicar el archivo — la fuente de verdad sigue siendo
# /Shared en la raíz. Sin la barra final: un patrón "shared/" no matchea un symlink con ese nombre,
# solo un directorio real, y quedaba sin ignorar.
Backend/src/shared
